---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm' | 'lg';
  class?: string;
  label?: string;
}

const { href, variant = 'primary', size = 'md', class: className, label } = Astro.props;
---

<a
  href={href}
  aria-label={label}
  class:list={['btn', `btn-${variant}`, size !== 'md' && `btn-${size}`, className]}
>
  <slot />
</a>
