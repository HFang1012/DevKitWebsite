---
// Static stand-in for the interactive preview. SF Symbols can't ship on the web,
// so the belt glyphs are simple line drawings.
const tools = [
  { name: 'Replay', d: 'M12 4a8 8 0 1 0 0 16a8 8 0 1 0 0-16Z M12 9.5a2.5 2.5 0 1 0 0 5a2.5 2.5 0 1 0 0-5Z' },
  { name: 'Converter', d: 'M5 8h13 M15 5l3 3-3 3 M19 16H6 M9 13l-3 3 3 3' },
  { name: 'Shrinker', d: 'M4 12h16 M12 3v6 M9 6l3 3 3-3 M12 21v-6 M9 18l3-3 3 3' },
  { name: 'Clipboard', d: 'M8 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1 M9 3h6v4H9Z' },
  { name: 'Notes', d: 'M7 4h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z M9 9h6 M9 13h6 M9 17h3' },
  { name: 'Stats', d: 'M5.07 18a8 8 0 1 1 13.86 0 M12 14l3-4 M11 14a1 1 0 1 0 2 0a1 1 0 1 0-2 0' },
  { name: 'Tasks', d: 'M5 7l2 2 3-3 M13 8h6 M5 15l2 2 3-3 M13 16h6' },
];
---

<section class="frame-wrap preview-section" aria-labelledby="preview-label">
  <div class="frame" data-preview>
    <div class="screen">
      <div class="window" aria-hidden="true">
        <div class="bar"><span></span><span></span><span></span></div>
        <div class="lines">
          <span style="width: 62%"></span>
          <span style="width: 48%"></span>
          <span style="width: 70%"></span>
          <span style="width: 36%"></span>
        </div>
      </div>

      <ul class="belt" aria-label="Utility Belt tools">
        {
          tools.map((tool, i) => (
            <li class:list={['tool', { selected: i === 0 }]} title={tool.name}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d={tool.d} />
              </svg>
              <span class="visually-hidden">{tool.name}</span>
            </li>
          ))
        }
      </ul>

      <div class="panel" aria-hidden="true">
        <div class="panel-row">
          <span class="dot"></span>
          <span class="bar-line" style="width: 40%"></span>
        </div>
        <span class="bar-line" style="width: 100%"></span>
        <span class="bar-line" style="width: 70%"></span>
        <span class="pill"></span>
      </div>
    </div>

    <p id="preview-label" class="label">
      <span class="card-title">Interactive preview</span>
      <span class="card-body">Coming soon: try the belt right here.</span>
    </p>
  </div>
</section>

<style>
  .preview-section {
    margin-top: var(--frame-gap);
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-card);
  }

  .screen {
    position: absolute;
    inset: 0;
  }

  /* A faint app window stands in for "whatever you are already doing". */
  .window {
    position: absolute;
    inset: 10% 14% 24% 22%;
    border: 1px solid var(--hairline);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.015);
  }

  .bar {
    display: flex;
    gap: 6px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--hairline);
  }

  .bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
  }

  .lines {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
  }

  .lines span,
  .bar-line {
    display: block;
    height: 8px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.05);
  }

  .belt {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 8px;
    list-style: none;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--r-pill);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .tool {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    color: var(--text);
  }

  .tool.selected {
    box-shadow: inset 0 0 0 1.5px rgba(244, 244, 241, 0.55);
  }

  .tool svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The attached panel sits beside the selected icon, as it does in the app. */
  .panel {
    position: absolute;
    left: 88px;
    top: calc(50% - 150px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: min(240px, 30%);
    padding: 18px;
    background: rgba(30, 30, 30, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
  }

  .panel-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--muted);
  }

  .pill {
    align-self: flex-start;
    width: 72px;
    height: 24px;
    border-radius: var(--r-pill);
    background: rgba(244, 244, 241, 0.85);
  }

  .label {
    position: absolute;
    right: 24px;
    bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    text-align: right;
  }

  @media (max-width: 700px) {
    .frame {
      aspect-ratio: 4 / 5;
    }

    .window {
      inset: 8% 6% 30% 24%;
    }

    .belt {
      left: 10px;
      padding: 6px;
    }

    .tool {
      width: 32px;
      height: 32px;
    }

    .panel {
      left: 64px;
      width: 52%;
    }

    .label {
      left: 24px;
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
