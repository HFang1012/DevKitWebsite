---
import Base from '../layouts/Base.astro';
import PageHeading from '../components/PageHeading.astro';
import ReleaseCard from '../components/ReleaseCard.astro';
import { releases, releasesPage } from '../data/releases';
import { site } from '../data/site';
---

<Base title="Releases" description="Every DevKit release, with downloads and what changed.">
  <PageHeading
    eyebrow="Releases"
    title="What's new in DevKit"
    lede={`DevKit needs ${site.requirement}.`}
  />

  <div class="list col">
    {releases.map((release, i) => <ReleaseCard release={release} latest={i === 0} />)}
    {
      releases.length === 0 && (
        <p class="card-body empty">
          The release list is not available right now. Every download is on{' '}
          <a href={releasesPage}>GitHub Releases</a>.
        </p>
      )
    }
  </div>
</Base>

<style>
  .empty {
    text-align: center;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: var(--grid-gap);
    max-width: calc(720px + var(--gutter) * 2);
    margin-top: 64px;
  }
</style>
